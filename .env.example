# TMDB (server-only, never exposed to the client)
# v4 "API Read Access Token" (starts with eyJ...) or a v3 api_key
NUXT_TMDB_API_TOKEN=
NUXT_TMDB_BASE_URL=https://api.themoviedb.org/3

# Session signing secret (server-only). Generate a long random string.
NUXT_JWT_SECRET=

# Supabase (Session 08, not used yet)
SUPABASE_URL=
SUPABASE_KEY=
